[general]
markup=pango
separator=true
separator_block_width=15

# >>> agent-usage >>>
[claude_usage]
command=~/.local/bin/agent-usage-i3block claude
interval=120
separator=true
separator_block_width=10

[codex_usage]
command=~/.local/bin/agent-usage-i3block codex
interval=120
# <<< agent-usage <<<

# replaced by iwgtk tray icon
#[wifi]
#command=~/.config/i3blocks/wifi
#interval=60

[mic]
command=~/.local/bin/i3-volume mic
interval=2
separator=true
separator_block_width=6

[volume]
command=~/.local/bin/i3-volume
interval=2

[rofi-calendar]
command=~/.config/i3blocks/rofi-calendar
interval=3600
BAR_POSITION=top

[time]
command=~/.config/i3blocks/time
interval=5
